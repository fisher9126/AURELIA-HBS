# Sao chép thành .env rồi đổi các giá trị bí mật trước khi chạy production
DB_NAME=aurelia
DB_USER=aurelia
DB_PASSWORD=aurelia_dev
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
MINIO_ACCESS_KEY=aurelia
MINIO_SECRET_KEY=aurelia_minio_dev
MINIO_PUBLIC_URL=http://localhost:9000
MAIL_FROM=stay@aureliaresort.vn
APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ORIGINS=http://localhost:5173
SPRING_PROFILES_ACTIVE=dev
APP_API_URL=http://localhost:8080

# Đăng nhập Google (Google Cloud Console > Credentials > OAuth client ID, loại Web application)
# Authorized redirect URI: {APP_API_URL}/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Apple: Services ID; Return URL: {APP_API_URL}/api/v1/auth/oauth/apple/callback (cần HTTPS)
APPLE_CLIENT_ID=

# VNPay sandbox: đăng ký tại https://sandbox.vnpayment.vn/devreg/ để nhận TMN code và hash secret
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# MoMo sandbox: lấy partner code, access key, secret key ở trang developer của MoMo
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
