# Sao chép thành .env.prod — script deploy.sh tự sinh các mật khẩu ngẫu nhiên nếu để trống.

# Có tên miền (đã trỏ bản ghi A về IP VPS): HTTPS tự động
#   SITE_ADDRESS=aurelia.tenmien.vn
#   PUBLIC_URL=https://aurelia.tenmien.vn
# Chưa có tên miền: chạy HTTP theo IP
#   SITE_ADDRESS=:80
#   PUBLIC_URL=http://203.0.113.10
SITE_ADDRESS=:80
PUBLIC_URL=http://YOUR_VPS_IP

DB_NAME=aurelia
DB_USER=aurelia
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
MINIO_ACCESS_KEY=aurelia
MINIO_SECRET_KEY=

# Email: mặc định Mailpit (xem ở PUBLIC_URL/mailpit). Gmail: smtp.gmail.com, 587, App Password
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=stay@aureliaresort.vn
MAILPIT_USER=admin
MAILPIT_HASH=

# Tùy chọn: Google / Apple / VNPay / MoMo sandbox (để trống thì nút tương ứng báo chưa cấu hình)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
